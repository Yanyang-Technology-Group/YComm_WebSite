# =============================================================================
# YComm environment template — copy to .env and fill in.
# Every variable is optional with a safe default unless marked REQUIRED.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public origin used in emails and OAuth redirects.
# 生产 WebSocket 必须改为公开 HTTPS 地址；本地开发可保留 localhost。
SITE_URL=http://localhost:3000
# Port for the standalone API process. Inside docker-compose use PORT.
PORT=3000
LOG_LEVEL=debug

# Branding overrides (defaults live in config/site.ts).
SITE_NAME=晏阳社区
SITE_TAGLINE=论坛讨论 · 资源下载
# SITE_DESCRIPTION=
# SITE_ICP=京ICP备00000000号
# SITE_SOURCE_URL=https://github.com/you/ycomm

# ---------------------------------------------------------------------------
# Database
#   DATABASE_DRIVER=pglite          -> embedded Postgres, zero install (dev/tests)
#   DATABASE_DRIVER=postgres        -> real Postgres (production), needs DATABASE_URL
# ---------------------------------------------------------------------------
DATABASE_DRIVER=pglite
# DATABASE_URL=postgres://user:pass@host:5432/ycomm
# Where PGlite keeps its files for local development.
PGLITE_DATA_DIR=./.data/pglite

# ---------------------------------------------------------------------------
# Sessions — SESSION_SECRET REQUIRED in production (>= 32 chars).
# Generate one with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
# SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_COOKIE_NAME=__Host-ycomm_session
# SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Uploads (local files). Keep below the 100MB Cloudflare tunnel limit.
# ---------------------------------------------------------------------------
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# Outbound mail — optional. Without a provider, emails are logged instead of
# sent (dev). Two providers, Resend takes priority when both are set:
#   1) Resend HTTP API (recommended): set RESEND_API_KEY only.
#   2) Self-hosted SMTP relay (kept for later): set SMTP_* below.
# MAIL_FROM is required with either; its domain must be verified on Resend.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=晏阳社区 <reply@yanyn.cn>

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=secret
# SMTP_SECURE=false
# MAIL_FROM=YComm <mailer@example.com>

# ---------------------------------------------------------------------------
# OAuth providers — optional adapters; hidden in the UI when unset.
# ---------------------------------------------------------------------------
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 人机验证 — CAP Worker（Cloudflare Workers + SHA-256 PoW），可选。
# 客户端脚本默认取 ${CAPTCHA_ENDPOINT}/cap.min.js（可用 CAPTCHA_SCRIPT 覆盖），
# 服务端校验走 ${CAPTCHA_ENDPOINT}/api/validate。未配置则验证码关闭。
# ---------------------------------------------------------------------------
# CAPTCHA_ENDPOINT=https://cap.yanyn.cn
# CAPTCHA_SCRIPT=https://cap.yanyn.cn/cap.min.js

# ---------------------------------------------------------------------------
# Reverse proxy / Cloudflare Tunnel
# ---------------------------------------------------------------------------
# Trust CF-Connecting-IP / X-Forwarded-For for rate limiting and bans.
TRUST_PROXY_HEADERS=true